# Copy to .env in the repository root. Never commit your actual .env.
# Required: DashScope SDK credential; use a model enabled for your account.
DASHSCOPE_API_KEY=replace-with-your-dashscope-api-key
LLM_MODEL=qwen3-max
FAST_LLM_MODEL=qwen3.5-flash
MAX_RESEARCH_ITERATIONS=5

# Local embeddings. Run: ollama pull qwen3-embedding:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=qwen3-embedding:4b

# Public synthetic demo data: no header, id,title,content,date,URL.
# Relative paths below resolve from the repository root.
CSV_FILE_PATH_ZH=examples/data/tech_news_zh.csv
CSV_FILE_PATH_EN=examples/data/tech_news_en.csv
# Isolate the demo indexes from any pre-existing research corpus.
CHROMA_DB_DIR_ZH=data/demo/chroma_zh
CHROMA_DB_DIR_EN=data/demo/chroma_en
BM25_INDEX_PATH_ZH=data/demo/bm25_zh.pkl
BM25_INDEX_PATH_EN=data/demo/bm25_en.pkl
# Model ID downloads from Hugging Face on first use; a local path also works.
RERANKER_MODEL_PATH=BAAI/bge-reranker-large

# Browser origins for a separately hosted frontend; / uses the same origin.
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Optional OpenAI-compatible endpoint for research scripts, not the RAG server.
# EVAL_API_KEY is separate from DASHSCOPE_API_KEY; no OPENAI_API_KEY fallback.
EVAL_API_KEY=
EVAL_BASE_URL=
EVAL_MODEL=gpt-4o-mini
EVAL_PROXY_URL=
# Run python -m experiments.<module> --help for experiment options.
